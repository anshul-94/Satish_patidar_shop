# Environment Variables — Example
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to Git

# ================================================
# Supabase Configuration
# Get from: Supabase Dashboard → Settings → API
# ================================================

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJ...your_anon_key_here

# ================================================
# ❌ NEVER add these to this file:
# ================================================
# SUPABASE_SERVICE_ROLE_KEY=  ← NEVER in frontend
# DB_PASSWORD=                ← NEVER in frontend
# ================================================

# Note for this project:
# This is a static HTML/CSS/JS site.
# Environment variables are NOT automatically read at runtime.
# You MUST manually paste the values into js/config.js
# See DEPLOYMENT.md for exact instructions.
